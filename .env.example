APP_NAME='LiberacionDeCanales'
APP_ENV=production
APP_KEY=base64:+mkQjAm826NhUUTyZ2cPdEuLuFDrt9dA8+G1Jq/v6c8=
APP_DEBUG=true
APP_URL=http://192.168.20.11:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=liberacion_canales
DB_USERNAME=postgres
DB_PASSWORD=HYGuzAmWdJ4ct1gLlJPB

# BD PostgreSQL externa (trazabilidad — solo lectura, módulo Verificación PCC). Opcional.
# Puedes usar POSTGRES_* (ej. POSTGRES_HOST, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD)
# o el prefijo DB_TRAZABILIDAD_* — si la base no está definida, no se consulta la tabla externa.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=nombre_bd_trazabilidad
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# DB_TRAZABILIDAD_SEARCH_PATH=trazabilidad_proceso,organizaciones,public
#
# Verificación PCC — hora H (0-23): antes de esa hora el día operativo es el del calendario anterior (permite guardar después de medianoche hasta el cierre de turno; alineado con hallazgos, default 7).
# VERIFICACION_PCC_TURNO_HORA_FIN=7

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Minutos sin actividad para cerrar sesión en Tiempo de usabilidad (default: SESSION_LIFETIME)
# USABILIDAD_INACTIVIDAD_MINUTOS=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting (notificaciones en tiempo real cuando hay nuevo hallazgo)
# Ejecutá en paralelo: php artisan reverb:start
BROADCAST_CONNECTION=reverb

# IP o hostname SIN PUERTO (el puerto WS es REVERB_SERVER_PORT, ej. 6001).
# Nunca pongas aquí el puerto de Laravel (ej. :8006) ni el de Reverb.
# Ejemplo: ECHO_WS_HOST=192.168.20.11

ECHO_WS_HOST=

# true = logs [Echo/Reverb] en la consola del navegador aunque APP_DEBUG=false (útil en móvil)

HALLAZGO_ECHO_DEBUG=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=liberacion-canales
REVERB_APP_KEY=lc-reverb-local-key
REVERB_APP_SECRET=lc-reverb-local-secret
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# Si Laravel ya usa el puerto 8080, no pongas Reverb en 8080: usa otro (ej. 6001).

# Tonos: public/sounds/not.mp3 — ver resources/js/hallazgo-notifications.js

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
